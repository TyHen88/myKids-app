# Copy this file to `.env` and fill in real values.
# `.env` (not `.env.local`) is required because drizzle.config.ts and
# scripts/prod.ts load it via `dotenv/config` for the db:* commands.

# ── Database (Neon serverless Postgres) ────────────────────────────────
# Connection string from your Neon project. Used by the app, drizzle-kit,
# and the seed script.
DATABASE_URL=

# ── Clerk authentication ───────────────────────────────────────────────
# From the Clerk dashboard (API Keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: override Clerk's default auth routes (this app serves custom
# pages under /[lang]/sign-in and /[lang]/sign-up).
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk user IDs allowed into the admin panel and /api/* admin routes.
# Comma-AND-space separated (the code splits on ", "), e.g. "user_abc, user_def".
CLERK_ADMIN_IDS=

# ── App ────────────────────────────────────────────────────────────────
# Public base URL, used by absoluteUrl() in lib/utils.ts.
# e.g. http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe (billing is currently stubbed — see CLAUDE.md — but the lib
#    and webhook still read these) ──────────────────────────────────────
# NOTE: the secret key var is STRIPE_API_SECRET_KEY, not STRIPE_SECRET_KEY.
STRIPE_API_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
